POSTGRES_PASSWORD=narratives
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Remote VPS: set POSTGRES_HOST to the server IP (or keep localhost with ssh -L 5432:127.0.0.1:5432 user@vps)
# Docker stack default is POSTGRES_HOST=postgres when unset in .env

