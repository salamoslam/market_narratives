POSTGRES_DB=narratives
POSTGRES_USER=narratives
POSTGRES_PASSWORD=narratives
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# VPS from laptop: keep POSTGRES_PORT=5433 and run (separate terminal, leave open):
#   ssh -N -L 5433:127.0.0.1:5432 deploy@100.90.153.59
# Local Docker Postgres uses host port 5432 — do not use 5432 in .env while tunneling (same credentials, wrong DB).
# Inside docker compose: POSTGRES_HOST=postgres, POSTGRES_PORT=5432

